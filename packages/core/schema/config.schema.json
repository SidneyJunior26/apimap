{
  "$ref": "#/definitions/Config",
  "definitions": {
    "Config": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": "API Map"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "kinds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "circle",
                  "square",
                  "diamond",
                  "hexagon"
                ]
              }
            },
            "additionalProperties": false
          },
          "default": {}
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": {}
        },
        "scan": {
          "type": "object",
          "properties": {
            "internalDomains": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "edit": {
          "anyOf": [
            {
              "type": "boolean",
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "github",
                  "default": "github"
                },
                "repo": {
                  "type": "string",
                  "pattern": "^[\\w.-]+\\/[\\w.-]+$"
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "default": "main"
                },
                "path": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "repo"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
