{
  "name": "@apimap/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./serialize": {
      "types": "./dist/serialize.d.ts",
      "import": "./dist/serialize.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js"
    },
    "./kinds": {
      "types": "./dist/kinds.d.ts",
      "import": "./dist/kinds.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "zod-to-json-schema": "^3.24.1"
  }
}
