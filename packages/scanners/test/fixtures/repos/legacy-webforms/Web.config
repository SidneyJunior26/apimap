<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- <add key="OldUrl" value="http://commented.acme.internal/" /> -->
  <connectionStrings>
    <add name="Billing" providerName="System.Data.SqlClient"
         connectionString="Data Source=billing-db.acme.internal,1433;Initial Catalog=Billing;User Id=billing_app;Password=Sup3rS3cret;" />
    <add name="Ledger" providerName="Oracle.ManagedDataAccess.Client"
         connectionString="User Id=ledger;Password=0racleS3cret;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=ledger-db.acme.internal)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=LEDGER)))" />
    <add name="Local" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Dev;" />
    <add name="Templated" connectionString="Server=${DB_HOST};Database=x;" />
  </connectionStrings>
  <appSettings>
    <add key="PaymentsUrl" value="http://payments.acme.internal/api/v1" />
    <add key="ApiKey" value="k3y-should-never-leak" />
    <add key="SmtpPassword" value="smtp-pass-leak" />
    <add key="PageSize" value="20" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp>
        <network host="mail.acme.internal" port="25" userName="mailer" password="m41l-leak" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.serviceModel>
    <client>
      <endpoint name="TaxService" address="http://tax.acme.internal/TaxService.svc" binding="basicHttpBinding" contract="ITaxService" />
    </client>
  </system.serviceModel>
  <log4net>
    <appender name="Syslog" type="log4net.Appender.UdpAppender">
      <remoteAddress value="syslog.acme.internal" />
      <remotePort value="514" />
    </appender>
  </log4net>
</configuration>
